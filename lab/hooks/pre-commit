#!/usr/bin/env bash
# Pre-commit hook: fast Semgrep scan on staged files.
#
# Fails CLOSED on findings. It exits non-zero so the commit is aborted, which
# is the whole point of a shift-left gate: a warning you can scroll past is not
# a control. It still fails OPEN on infrastructure problems (semgrep missing,
# timeout, unparseable output), because a broken scanner must never wedge a
# developer's ability to commit.
#
# Escape hatches, in order of preference:
#   git commit --no-verify        skip all hooks for one commit
#   CM_HOOK_SKIP=1 git commit     skip just this hook
#   CM_HOOK_BUDGET=30             raise the scan timeout in seconds
set -uo pipefail

BUDGET="${CM_HOOK_BUDGET:-10}"
ok() { exit 0; }

[ "${CM_HOOK_SKIP:-0}" = "1" ] && ok
command -v semgrep >/dev/null 2>&1 || ok

# Staged JavaScript/TypeScript source files only
mapfile -d '' -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.ts' 2>/dev/null)
[ ${#STAGED[@]} -eq 0 ] && ok

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
FILES=()
for f in "${STAGED[@]}"; do
  [ -n "$f" ] || continue
  mkdir -p "$TMP/$(dirname "$f")"
  git show ":$f" > "$TMP/$f" 2>/dev/null && FILES+=("$TMP/$f")
done
[ ${#FILES[@]} -eq 0 ] && ok

OUT="$TMP/semgrep.json"
timeout "$BUDGET" semgrep scan --config p/javascript --metrics=off --quiet --json --disable-version-check -o "$OUT" "${FILES[@]}" >/dev/null 2>&1 || ok
[ -s "$OUT" ] || ok

python3 - "$OUT" "$TMP" <<'PY'
import json, sys, os

out, tmp = sys.argv[1], sys.argv[2]
try:
    res = json.load(open(out)).get("results", [])
except Exception:
    sys.exit(0)          # unparseable output is an infra problem: fail open

if not res:
    sys.exit(0)

def rel(p): return os.path.relpath(p, tmp)

R, B, D = "\033[31m", "\033[1m", "\033[0m"
print(f"\n{R}{B}❌ cm-hook: commit blocked. Semgrep found {len(res)} finding(s) in staged files:{D}")
for r in res[:5]:
    rule = r.get("check_id", "finding").rsplit(".", 1)[-1]
    path = rel(r.get("path", ""))
    line = (r.get("start") or {}).get("line", 0)
    print(f"   {R}• {path}:{line}{D} -> {rule}")
if len(res) > 5:
    print(f"   ...and {len(res) - 5} more")

print(f"""
{B}Remediate with CodeMender, then commit again:{D}
   semgrep scan --config=p/javascript --json -o /tmp/semgrep.json src/
   python3 lab/scripts/semgrep-to-cm.py /tmp/semgrep.json -o /tmp/cm-findings.json
   cm report import -f /tmp/cm-findings.json -p .
   cm report                      # copy the finding ID you want
   cm fix <FINDING_ID> -y --bypass-warning --context "<file and what to fix>"

{B}Stage the file you fixed,{D} not the whole tree. `git add src/` picks up
every modified file, including anything an open editor tab wrote back to disk
while the agent was working. Name the file, then check it with:
   git show --stat HEAD

{B}To commit anyway:{D} git commit --no-verify
""")

sys.exit(1)
PY
