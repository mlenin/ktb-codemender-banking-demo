node_modules/
npm-debug.log
.DS_Store
.env
*.patch
*.log

# Generated by the pipeline's `npm install` step. This repo ships no lockfile,
# so the install creates one on the runner. Without this entry the file is
# untracked but not ignored, which means the `git add -A` in the remediation
# loop would sweep it into the autonomous pull request. In practice the
# workspace reset deletes it first, but that is accidental protection: it only
# holds while vcs.type is set correctly. This entry makes it deterministic.
package-lock.json

# CodeMender workspace and local scan artifacts.
# Keeps `cm init` state and Semgrep intermediates out of both the learner's
# local commits and the autonomous remediation pull request.
.codemender/
semgrep.json
cm-findings.json

# CodeMender project marker. This is a FILE, not a directory, so it must be
# listed without a trailing slash. With a slash the rule silently never matches
# and the marker ends up committed into the remediation pull request.
.cm_project

# Proof-of-concept exploit artifacts written by `cm verify`. These are working
# attack payloads. They must never reach a pull request.
.exploit/

# Short-lived Workload Identity Federation credentials written into the
# workspace by google-github-actions/auth. The pipeline runs `git add -A`, so
# without this entry the credential config is committed into the remediation
# pull request. It holds no long-lived secret, but publishing it is still wrong.
gha-creds-*.json
